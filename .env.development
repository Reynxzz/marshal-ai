# Marshal API — local demo: the plant runs in this process on the API's own bus, so
# /api/v1/events carries live decisions without CARLA. Gemini judges the route decisions; the
# media judgements stay offline (their images only resolve in GCS on the CARLA host).
# Sourced by the root Makefile (make dev / make api). Edit this file to change a setting.
MARSHAL_RUN_PLANT=1
MARSHAL_PLANT_SPEED=8
MARSHAL_LLM=gemini
MARSHAL_ROUTE=always
MARSHAL_STORE=memory
MARSHAL_BUS=memory
GOOGLE_CLOUD_LOCATION=asia-southeast1

# CARLA batch runs (POST /api/v1/batches) stay off on this laptop: they launch CARLA scripts, so
# they only work on the CARLA host (MARSHAL_BATCH=1, docs/BATCH_RUN_RUNBOOK.md).
MARSHAL_BATCH=0
