# Gemini via Vertex AI (recommended) or AI Studio
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_API_KEY=...   # only when GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used by every agent; override per environment
MARSHAL_MODEL=gemini-2.5-flash

# Evidence storage. "none" keeps gs:// URIs as labels; "gcs" uploads the photo behind each
# verdict so the URI in a record resolves. Bucket defaults to marshal-artifacts-$PROJECT.
MARSHAL_ARTIFACTS=none
# MARSHAL_BUCKET=marshal-artifacts-your-project

# Record history. "none" keeps only the live copy; "bq" appends every state change to
# BigQuery (dataset "marshal", table "record_history").
MARSHAL_HISTORY=none

# Backends: "memory" for local dev, "gcp" / "carla" on the VM
MARSHAL_BUS=memory
# MARSHAL_STORE=gcp makes the Control Tower GETs read from CARLA's Firestore records. Set
# MARSHAL_BUS=gcp with it so /events streams live flow events. Other existing control endpoints
# remain read-only; batch CARLA runs are separately enabled below. Needs the "gcp" extra.
MARSHAL_STORE=memory
# fake (instant, no physics) | carla (GPU VM)
MARSHAL_DRIVING=fake
# Control Tower API only: MARSHAL_RUN_PLANT=1 runs the plant in-process on the API's own bus, on
# the fake driving system, so /api/v1/events carries live decisions without CARLA. With
# MARSHAL_LLM=gemini only the route decisions go to Gemini (media judgements stay offline: their
# images only resolve in GCS on the host). MARSHAL_PLANT_SPEED scales its simulated time.
# MARSHAL_RUN_PLANT=1
# MARSHAL_PLANT_SPEED=8
# test lab: sim | carla; empty picks from MARSHAL_DRIVING
MARSHAL_LAB=
# "gemini", or "offline" for deterministic stand-ins (rehearsals without credentials)
MARSHAL_LLM=gemini

# Backend database (docs-be/ERD_AND_DATA_MODELING.md). Local dev uses SQLite;
# staging/production switches to PostgreSQL by changing this one URL.
MARSHAL_DB_URL=sqlite+aiosqlite:///./marshal.db
# MARSHAL_DB_URL=postgresql+asyncpg://marshal_app:password@host:5432/marshal_db

# CARLA server (GPU VM)
CARLA_HOST=localhost
CARLA_PORT=2000
CARLA_TIMEOUT_S=20
CARLA_VERSION=0.9.16

# CARLA-host only: the API and runner must sit next to CARLA. Batch state lives in Firestore, so
# the ephemeral instance keeps no database. On the host also set
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/marshal/wif.json (Workload Identity Federation; see
# marshal-tf/gcp/README.md) instead of a service-account key.
MARSHAL_BATCH=0
MARSHAL_BATCH_STORE=memory
MARSHAL_BATCH_MAX_CARS=6
MARSHAL_BATCH_TIMEOUT_S=1800
MARSHAL_BATCH_LAB_TIMEOUT_S=900
MARSHAL_BATCH_LAB_ADVERSARIAL=4
