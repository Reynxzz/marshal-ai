# Gemini via Vertex AI (recommended) or AI Studio
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_API_KEY=...   # only when GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used by every agent; override per environment
MARSHAL_MODEL=gemini-2.5-flash

# Backends: "memory" for local dev, "gcp" / "carla" on the VM
MARSHAL_BUS=memory
MARSHAL_STORE=memory
# fake (instant, no physics) | metadrive (laptop simulator) | carla (GPU VM)
MARSHAL_DRIVING=fake
# test lab: sim | scenic (Scenic on MetaDrive) | carla; empty picks from MARSHAL_DRIVING
MARSHAL_LAB=
# MetaDrive window: topdown (the whole plant) or 3d (a camera chasing the car that last got a mission)
MARSHAL_VIEW=
# "gemini", or "offline" for deterministic stand-ins (rehearsals without credentials)
MARSHAL_LLM=gemini

# CARLA server (GPU VM)
CARLA_HOST=localhost
CARLA_PORT=2000
