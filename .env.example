# Gemini via Vertex AI (recommended) or AI Studio
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_API_KEY=...   # only when GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used by every agent; override per environment
MARSHAL_MODEL=gemini-2.5-flash

# Evidence storage. "none" keeps gs:// URIs as labels; "gcs" uploads the photo behind each
# verdict so the URI in a record resolves. Bucket defaults to marshal-artifacts-$PROJECT.
MARSHAL_ARTIFACTS=none
# MARSHAL_BUCKET=marshal-artifacts-your-project

# Record history. "none" keeps only the live copy; "bq" appends every state change to
# BigQuery (dataset "marshal", table "record_history").
MARSHAL_HISTORY=none

# Backends: "memory" for local dev, "gcp" / "carla" on the VM
MARSHAL_BUS=memory
MARSHAL_STORE=memory
MARSHAL_DRIVING=fake
# "gemini", or "offline" for deterministic stand-ins (rehearsals without credentials)
MARSHAL_LLM=gemini

# CARLA server (GPU VM)
CARLA_HOST=localhost
CARLA_PORT=2000
CARLA_TIMEOUT_S=20
CARLA_VERSION=0.9.16
