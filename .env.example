# Gemini is REQUIRED by default: without a key or Vertex config, AI calls fail and the batch
# stops with an error instead of silently using offline answers.
GOOGLE_GENAI_API_KEY=

# Or use Vertex AI instead of an API key:
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Model used by all AI tasks.
GEMINI_MODEL=gemini-2.5-flash

# Opt-in offline mode: set true to run every task with the deterministic offline handlers
# (no Gemini calls; UI/report show a `degraded` badge). Leave unset to force Gemini.
VITE_AI_OFFLINE=
