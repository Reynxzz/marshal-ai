# Marshal API — deployed demo: same in-process plant as development (this deployment has no
# CARLA host). On a host that drives CARLA, run the plant there instead
# (scripts/run_carla_plant.sh) and set MARSHAL_RUN_PLANT=0, MARSHAL_STORE=gcp, MARSHAL_BUS=gcp.
# Sourced by the root Makefile (make api-prod). Edit this file to change a setting.
MARSHAL_RUN_PLANT=1
MARSHAL_PLANT_SPEED=8
MARSHAL_LLM=gemini
MARSHAL_ROUTE=always
MARSHAL_STORE=memory
MARSHAL_BUS=memory
GOOGLE_CLOUD_LOCATION=asia-southeast1

# CARLA batch runs stay off here too: enable MARSHAL_BATCH=1 only on the host that drives CARLA
# (docs/BATCH_RUN_RUNBOOK.md).
MARSHAL_BATCH=0
